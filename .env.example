# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=notifications_db

# Message Queue Configuration
MQ_HOST=localhost
MQ_PORT=5672
MQ_USER=guest
MQ_PASS=guest
MQ_QUEUE_NAME=notification_events
MQ_DLQ_NAME=notification_dead_letter_queue

# Application Configuration
MAX_RETRIES=3
RETRY_INITIAL_DELAY=1000
PORT=3000

# Startup Resilience (useful on cloud platforms where dependencies may come up slowly)
STARTUP_RETRY_ATTEMPTS=20
STARTUP_RETRY_DELAY_MS=3000
